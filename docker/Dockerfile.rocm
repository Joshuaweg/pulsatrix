# Build environment for the HIP/ROCm DeviceBackend (PULSATRIX_ENABLE_HIP=ON).
#
# Base is AMD's own validated ROCm image, pinned to a release rather than tracking latest or
# matching a distro package. The default is ROCm 10.0.0 (HIP 7.15), the first release that lists
# gfx1151 (Strix Halo) officially; roadmap HIP-9 evaluated it against 7.2.4, the previous pin,
# and found every test passing and the same speed (docs/gpu-profiling.md). 7.2.4 stays
# selectable with --build-arg ROCM_BASE=rocm/dev-ubuntu-24.04:7.2.4-complete, or
# PULSATRIX_ROCM_VERSION=7.2.4 for scripts/rocm-build.sh. Why a pinned image at all:
#
#  1. ROCm 7.1.x is broken on gfx1151. hipStreamCreate segfaults inside
#     libhsa-runtime64.so.1 at HSA hardware-queue creation. Device enumeration, hipSetDevice
#     and context init all succeed first, so it fails late and looks like application code.
#     Memory, RLIMIT_MEMLOCK, device-node permissions and container confinement were each
#     ruled out by test. 7.2.4 and 10.0.0 run the same code correctly. Ubuntu's archive ships
#     7.1.x, so installing ROCm from the distro is NOT a working substitute for this image.
#  2. The base image is Ubuntu 24.04, which is on AMD's supported OS matrix. Host distro
#     then does not matter -- per ROCm 6.4+, driver and userspace are decoupled and the host
#     carries only the amdgpu/amdkfd driver.
#
# Three packages are added. The 7.2.4 base has none of them (10.0.0's already has libdw1), and
# the project needs all three:
# cmake is the build system, git is required by FetchContent for GoogleTest (and pybind11
# under PULSATRIX_ENABLE_PYTHON), and libdw1 is loaded by rocprofv3's tool library, without
# which scripts/profile_hip.sh can't start ("libdw.so.1: cannot open shared object file").
# Nothing about the ROCm stack itself is modified.
ARG ROCM_BASE=rocm/dev-ubuntu-24.04:10.0.0-full
FROM ${ROCM_BASE}

RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake git ca-certificates libdw1 \
 && rm -rf /var/lib/apt/lists/*

# ROCm 10's image keeps its libraries under /opt/rocm/core-10.0/lib (reached through /opt/rocm/lib)
# and, unlike 7.2.4's, doesn't register that directory with the dynamic loader, so programs
# built against hipBLAS fail to start ("libhipblas.so.3: cannot open shared object file").
# Registering it is a no-op on 7.2.4, whose image already does.
RUN echo /opt/rocm/lib > /etc/ld.so.conf.d/pulsatrix-rocm.conf && ldconfig
